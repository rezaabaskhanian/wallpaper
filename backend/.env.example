# ============================================================
# فروشگاه والپیپر — نمونه‌ی متغیرهای محیطی (12-Factor Config)
# این فایل را به .env کپی کنید و مقادیر را تنظیم کنید.
# ============================================================

# محیط اجرا: development | production
ENV=development

# سطح لاگ: info | debug
LOG_LEVEL=info

# سرور HTTP
HTTP_PORT=8090

# دامنه‌های مجاز CORS (با کاما جدا کنید)
ALLOWED_ORIGINS=http://localhost:3000

# مسیر فایل‌های migration (داخل Docker معمولاً ./migrations)
MIGRATIONS_DIR=../internal/repository/postgres/migrations

# در production برای اجرای مهاجرت‌ها این را true کنید
RUN_MIGRATIONS=false

# پایگاه داده PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=reza_abasi
DB_PASSWORD=change_me
DB_NAME=wallpaper_db

# کلید سادهٔ ادمین برای اندپوینت‌های نوشتن (POST /api/v1/wallpapers و /categories)
# خالی = محافظت غیرفعال (فقط برای توسعهٔ محلی)
ADMIN_API_KEY=

# ============================================================
# Object Storage (آروان کلاود) — برای آپلود عکس والپیپر/شهید/رهبر از پنل ادمین
# ============================================================

# هاست S3 بدون نام باکت، مثل s3.ir-thr-at1.arvanstorage.ir
ARVAN_S3_ENDPOINT=s3.ir-thr-at1.arvanstorage.ir
ARVAN_S3_REGION=ir-thr-at1
ARVAN_S3_BUCKET=wallpaper-app
ARVAN_S3_ACCESS_KEY=
ARVAN_S3_SECRET_KEY=
ARVAN_S3_USE_SSL=true

# دامنه‌ی عمومی برای ساخت لینک نهایی فایل‌ها: اول با آدرس مستقیم باکت شروع کنید،
# بعد از وصل‌شدن CDN به cdn.wallpaperapp.ir تغییرش بدید (فایل‌های قبلی همچنان کار می‌کنند).
ARVAN_S3_PUBLIC_BASE_URL=https://wallpaper-app.s3.ir-thr-at1.arvanstorage.ir
