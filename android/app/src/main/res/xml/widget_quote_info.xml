<?xml version="1.0" encoding="utf-8"?>
<!--
  Metadata for the clock/quote home-screen widget (see QuoteWidgetProvider.kt).
  updatePeriodMillis is clamped by Android to a 30-minute floor regardless of
  the value given, which is fine — the clock itself (TextClock) ticks live
  without any of our code running; only the quote line needs periodic updates.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_quote"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
